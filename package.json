{
  "name": "success-cv-backend",
  "version": "1.0.0",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "migrate:status": "node scripts/check-migration-status.js",
    "studio": "drizzle-kit studio",
    "dev": "nodemon server.js",
    "start": "node server.js",
    "worker": "node queues/workers/resume-analysis.worker.js",
    "worker:dev": "nodemon queues/workers/resume-analysis.worker.js",
    "worker:rewrite": "node queues/workers/resume-rewrite.worker.js",
    "worker:rewrite:dev": "nodemon queues/workers/resume-rewrite.worker.js",
    "worker:email": "node queues/workers/email.worker.js",
    "worker:email:dev": "nodemon queues/workers/email.worker.js",
    "worker:job-scraping": "node queues/workers/job-scraping.worker.js",
    "worker:job-scraping:dev": "nodemon queues/workers/job-scraping.worker.js",
    "worker:job-matching": "node queues/workers/job-matching.worker.js",
    "worker:job-matching:dev": "nodemon queues/workers/job-matching.worker.js",
    "worker:manual-analysis": "node queues/workers/manual-analysis.worker.js",
    "worker:manual-analysis:dev": "nodemon queues/workers/manual-analysis.worker.js",
    "worker:roadmap": "node queues/workers/career-roadmap.worker.js",
    "worker:roadmap:dev": "nodemon queues/workers/career-roadmap.worker.js",
    "worker:detailed-roadmap": "node queues/workers/detailed-roadmap.worker.js",
    "worker:detailed-roadmap:dev": "nodemon queues/workers/detailed-roadmap.worker.js",
    "workers": "concurrently \"npm run worker\" \"npm run worker:rewrite\" \"npm run worker:email\" \"npm run worker:job-scraping\" \"npm run worker:job-matching\" \"npm run worker:manual-analysis\" \"npm run worker:roadmap\" \"npm run worker:detailed-roadmap\"",
    "workers:dev": "concurrently \"npm run worker:dev\" \"npm run worker:rewrite:dev\" \"npm run worker:email:dev\" \"npm run worker:job-scraping:dev\" \"npm run worker:job-matching:dev\" \"npm run worker:manual-analysis:dev\" \"npm run worker:roadmap:dev\" \"npm run worker:detailed-roadmap:dev\"",
    "seed:themes": "node drizzle/seeds/themes.seed.js",
    "seed:themes:images": "node drizzle/seeds/themes-with-images.seed.js",
    "seed:themes:full": "node drizzle/seeds/themes-with-images.seed.js --generate-images",
    "generate:theme-images": "node drizzle/seeds/theme-image-downloader.js",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.js",
    "test:scraping": "node scripts/test-scraping-system.js"
  },
