# ── Scraper Service Config ────────────────────────────────────────────
# Copy to .env and fill in values

# API key shared with the Node.js backend (X-API-Key header)
SCRAPER_API_KEY=change-me-to-a-strong-secret

# Uvicorn settings
HOST=0.0.0.0
PORT=8001

# Scrapling browser options
HEADLESS=true
# Optional: proxy for browser-based scrapers
# PROXY=http://user:pass@host:port
