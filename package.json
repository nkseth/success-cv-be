    "@azure/storage-blob": "^12.27.0",
    "@getbrevo/brevo": "^3.0.1",
    "ai": "^5.0.98",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.63.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "formdata-node": "^6.0.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "opossum": "^9.0.0",
    "postgres": "^3.4.7",
    "puppeteer": "^24.36.0",
    "razorpay": "^2.9.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "xml2js": "^0.6.2",
    "zod": "^4.3.5"
