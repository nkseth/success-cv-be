# ╔══════════════════════════════════════════════════════════════════════╗
# ║  Success-CV Docker Environment                                     ║
# ║  Copy to .env and fill in your values                              ║
# ║  Usage: docker compose up --build                                  ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Node.js / Express ─────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# ── Database (PostgreSQL — external, NOT managed by this compose) ─────
DATABASE_URL=postgresql://user:password@host:5432/successcv

# ── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET_ACCESS_KEY=change-me-to-a-strong-secret-min-32-chars

# ── Redis (auto-configured by docker-compose, override only if external)
# REDIS_HOST and REDIS_PORT are set automatically in docker-compose.yml
# Only set REDIS_URL if using an external Redis instance:
# REDIS_URL=redis://user:password@external-redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ── Scraper Service ──────────────────────────────────────────────────
# Auto-configured by docker-compose (SCRAPER_SERVICE_URL=http://scraper:8001)
SCRAPER_SERVICE_SECRET=change-me-to-a-strong-secret

# Optional: proxy for browser-based scrapers
# SCRAPER_PROXY=http://user:pass@proxy-host:port

# ── CORS ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ── Azure AI (for resume analysis) ───────────────────────────────────
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=

# ── Azure Blob Storage ───────────────────────────────────────────────
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=

# ── Email (Brevo) ────────────────────────────────────────────────────
# BREVO_API_KEY=

# ── Razorpay (Billing) ──────────────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ── Rate Limiting ────────────────────────────────────────────────────
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# ── Swagger ──────────────────────────────────────────────────────────
# SWAGGER_ENABLED=false
