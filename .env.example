# Database Configuration
DATABASE_URL="postgres://username:password@host:5432/database"

# JWT Configuration (REQUIRED FOR PRODUCTION)
JWT_SECRET_ACCESS_KEY="your-access-token-secret-key-here"
JWT_SECRET_REFRESH_KEY="your-refresh-token-secret-key-here"

# Server Configuration
PORT=4000
NODE_ENV="development"  # Set to "production" for production deployments
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
FRONTEND_URL="https://yourdomain.com"

# JWT Expiration
ACCESS_EXPIRES_IN="1d"
# ACCESS_EXPIRES_IN="15m"
REFRESH_EXPIRES_IN="7d"

# ===== PRODUCTION SECURITY CONFIGURATION =====

# Rate Limiting (optional - defaults work for most cases)
# RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in ms (default: 15 min)
# RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window (default: 100)

# Request Timeout (optional - defaults to 30 seconds)
# REQUEST_TIMEOUT_MS=30000

# Body Parser Limit (optional - default: 10mb)
# BODY_PARSER_LIMIT=10mb

# Swagger Documentation (optional - disabled in production by default)
# Set to "true" to enable in production (not recommended)
# SWAGGER_ENABLED=false

# ============================================

# Azure Communication Services
AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING="endpoint=https://your-service.communication.azure.com/;accesskey=your-key"
AZURE_COMMUNITY_KEY="your-azure-community-key"
AZURE_COMMUNICATION_EMAIL_SENDER=alerts@yourdomain.com

# Azure AI Services
AZURE_API_KEY=your-azure-ai-api-key
AZURE_RESOURCE_NAME=your-azure-resource-name

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net"
AZURE_STORAGE_ACCOUNT_NAME=youraccount
AZURE_STORAGE_ACCOUNT_KEY=your-storage-account-key

# Brevo (Email Service)
BREVO_API_KEY="your-brevo-api-key"

# Feature Flags
JOB_MATCHING_ENABLED=true

# Indian Job Scraper Microservice
SCRAPER_SERVICE_URL=http://localhost:8001
SCRAPER_SERVICE_SECRET=your-strong-secret-key-here

# Country API
COUNTRY_API_KEY=your-country-api-key

# Redis Configuration (REQUIRED FOR PRODUCTION)
REDIS_HOST=your-redis-host.com
REDIS_PORT=16464
REDIS_PASSWORD=your-redis-password
REDIS_USERNAME=default
REDIS_DB_CACHE=0
REDIS_DB_QUEUE=0
REDIS_CLUSTER_MODE=false
REDIS_TLS=true  # IMPORTANT: Enable TLS in production
REDIS_MAX_RETRIES=3

# Worker Configuration
WORKER_CONCURRENCY=5

# Resume Parser (unstructured.ai)
UNSTRUCTURED_API_KEY=your-unstructured-api-key
RESUME_PARSER_URL=https://unstructured.safhire.ai/general/v0/general
