# ╔══════════════════════════════════════════════════════════════════════╗
# ║  Success-CV — Workers Dockerfile                                   ║
# ║  Runs all 8 BullMQ background workers via shell background jobs    ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Build stage ────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install production deps only (workers don't need devDependencies)
RUN pnpm install --frozen-lockfile --prod

# ── Production stage ──────────────────────────────────────────────────
FROM node:20-alpine

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy production dependencies from builder
COPY --from=builder /app/node_modules ./node_modules

# Copy only the source files workers need
COPY package.json pnpm-workspace.yaml ./
COPY queues/     ./queues/
COPY services/   ./services/
COPY models/     ./models/
COPY config/     ./config/
COPY middleware/ ./middleware/
COPY utils/      ./utils/
COPY drizzle/    ./drizzle/

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 && \
    chown -R nodejs:nodejs /app

USER nodejs

# Health-check: verify all worker files exist (shell, no CJS/ESM ambiguity)
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD sh -c 'for f in \
        queues/workers/resume-analysis.worker.js \
        queues/workers/resume-rewrite.worker.js \
        queues/workers/email.worker.js \
        queues/workers/job-scraping.worker.js \
        queues/workers/job-matching.worker.js \
        queues/workers/manual-analysis.worker.js \
        queues/workers/career-roadmap.worker.js \
        queues/workers/detailed-roadmap.worker.js; \
        do [ -f "$f" ] || exit 1; done'

# Run all 8 workers as background shell jobs — no concurrently devDep needed.
# If any worker exits (crash/signal), the 'wait -n' returns and the container
# exits so Docker's restart policy can bring everything back cleanly.
CMD ["sh", "-c", \
    "node queues/workers/resume-analysis.worker.js & \
     node queues/workers/resume-rewrite.worker.js & \
     node queues/workers/email.worker.js & \
     node queues/workers/job-scraping.worker.js & \
     node queues/workers/job-matching.worker.js & \
     node queues/workers/manual-analysis.worker.js & \
     node queues/workers/career-roadmap.worker.js & \
     node queues/workers/detailed-roadmap.worker.js & \
     wait"]
