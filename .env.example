# Database Configuration
DATABASE_URL="postgres://username:password@host:5432/database"

# JWT Configuration
JWT_SECRET_ACCESS_KEY="your-access-token-secret-key-here"
JWT_SECRET_REFRESH_KEY="your-refresh-token-secret-key-here"

# Server Configuration
PORT=4000
NODE_ENV="development"
ALLOWED_ORIGINS=http://localhost:3000,*.localhost:3000
FRONTEND_URL="http://localhost:3000"

# JWT Expiration
ACCESS_EXPIRES_IN="1d"
# ACCESS_EXPIRES_IN="15m"
REFRESH_EXPIRES_IN="7d"

# Azure Communication Services
AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING="endpoint=https://your-service.communication.azure.com/;accesskey=your-key"
AZURE_COMMUNITY_KEY="your-azure-community-key"
AZURE_COMMUNICATION_EMAIL_SENDER=alerts@yourdomain.com

# Azure AI Services
AZURE_API_KEY=your-azure-ai-api-key
AZURE_RESOURCE_NAME=your-azure-resource-name

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net"
AZURE_STORAGE_ACCOUNT_NAME=youraccount
AZURE_STORAGE_ACCOUNT_KEY=your-storage-account-key

# Brevo (Email Service)
BREVO_API_KEY="your-brevo-api-key"

# Country API
COUNTRY_API_KEY=your-country-api-key

# Redis Configuration
REDIS_HOST=your-redis-host.com
REDIS_PORT=16464
REDIS_PASSWORD=your-redis-password
REDIS_USERNAME=default
REDIS_DB_CACHE=0
REDIS_DB_QUEUE=0
REDIS_CLUSTER_MODE=false
REDIS_TLS=false
REDIS_MAX_RETRIES=3

# Worker Configuration
WORKER_CONCURRENCY=5

# Resume Parser (unstructured.ai)
UNSTRUCTURED_API_KEY=your-unstructured-api-key
RESUME_PARSER_URL=https://unstructured.safhire.ai/general/v0/general
